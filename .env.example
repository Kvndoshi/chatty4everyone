# Required in production: 16+ random characters. Encrypts stored API keys and signs visitor sessions.
# Generate one with: openssl rand -base64 32
CHATTY_SECRET=

# Optional: store bots in Upstash Redis (needed on serverless hosts such as Vercel).
# Without these, bots are saved to .data/bots.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: public URL used in the generated install code (defaults to the editor's origin).
NEXT_PUBLIC_APP_URL=

# Optional: OpenRouter-compatible API endpoint.
OPENROUTER_BASE_URL=
